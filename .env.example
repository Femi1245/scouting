# Demo Mode (default). Set to "false" when wiring live providers.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=https://zumeliascout.vercel.app

# Database (local experiments)
DATABASE_URL="file:./dev.db"

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI — Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gmail OAuth (Integrations → Connect Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://zumeliascout.vercel.app/api/oauth/google/callback

# Gmail Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/TOPIC_NAME
GMAIL_PUBSUB_SUBSCRIPTION=projects/PROJECT_ID/subscriptions/SUBSCRIPTION_NAME

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://zumeliascout.vercel.app/api/oauth/microsoft/callback

# Optional system email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Encrypt stored OAuth tokens (32+ chars)
TOKEN_ENCRYPTION_KEY=
